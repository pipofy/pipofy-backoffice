{
  "name": "pipofy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node set-env.mjs development && ng serve",
    "build": "node set-env.mjs production && ng build",
    "build:staging": "node set-env.mjs staging && ng build --configuration staging",
    "watch": "node set-env.mjs development && ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "check:scripts": "node test-set-env.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.2.7"
  }
}
